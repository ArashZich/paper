<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- header -->
        <LinearLayout
            style="@style/Row"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="14dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- one-time setup -->
        <LinearLayout
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/outline_box"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:text="@string/setup_title"
                android:textStyle="bold" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="6dp"
                android:text="@string/setup_body"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/outline_box"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="@color/ink"
                android:textDirection="ltr"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <Button
                android:id="@+id/copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/copy" />
        </LinearLayout>

        <!-- big power button -->
        <LinearLayout
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@drawable/outline_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/ic_power"
                android:tint="@color/chip_text" />

            <TextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:duplicateParentState="true"
                android:textColor="@color/chip_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/state_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textColor="@color/chip_text"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- presets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/p_kindle"
                style="@style/ChipBox">

                <ImageView
                    style="@style/ChipIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_book" />

                <TextView
                    style="@style/ChipText"
                    android:text="@string/preset_kindle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/p_boox"
                style="@style/ChipBox">

                <ImageView
                    style="@style/ChipIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_screen" />

                <TextView
                    style="@style/ChipText"
                    android:text="@string/preset_boox" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/p_night"
                style="@style/ChipBox">

                <ImageView
                    style="@style/ChipIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_moon" />

                <TextView
                    style="@style/ChipText"
                    android:text="@string/preset_night" />
            </LinearLayout>
        </LinearLayout>

        <!-- look: sliders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/outline_box"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/Row">

                <ImageView
                    style="@style/RowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_tone" />

                <TextView
                    android:id="@+id/tone_label"
                    style="@style/Label" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/tone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:max="60" />

            <LinearLayout
                style="@style/Row"
                android:layout_marginTop="8dp">

                <ImageView
                    style="@style/RowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warm" />

                <TextView
                    android:id="@+id/warmth_label"
                    style="@style/Label" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/warmth"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:max="80" />
        </LinearLayout>

        <!-- schedule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/outline_box"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout style="@style/Row">

                <ImageView
                    style="@style/RowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Label"
                        android:text="@string/schedule" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/schedule_hint"
                        android:textColor="@color/ink_soft"
                        android:textSize="12sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/schedule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/times"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/t_from"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/outline_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/t_to"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/outline_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
